  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.engine.json --noEmit && tsc -p tsconfig.mcp.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:build": "node mcp/start.mjs --build-only",
    "mcp": "node mcp/start.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/rubik-wet-paint": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
